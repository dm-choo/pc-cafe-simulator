{
  "name": "pc-cafe-simulator",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.19.0 <25"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src tests *.ts",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "assets:build": "node scripts/assets/build-seat.mjs && node scripts/assets/fetch-materials.mjs",
    "predev": "npm run assets:build",
    "prebuild": "npm run assets:build"
  },
  "dependencies": {
    "@dimforge/rapier3d-compat": "0.20.0",
    "@fontsource-variable/noto-sans-kr": "5.3.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "three": "0.185.1"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.63.0",
    "@types/node": "24.13.3",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "@types/three": "0.185.4",
    "eslint": "10.10.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.69.0",
    "vite": "8.2.2",
    "vitest": "5.0.0"
  }
}
